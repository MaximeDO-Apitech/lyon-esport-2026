{
  "$schema": "http://json-schema.org/draft-04/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": ["revision", "program", "preview", "lastCommandId", "updatedAt"],
  "properties": {
    "revision": { "type": "integer", "minimum": 0 },
    "program": { "$ref": "#/definitions/surface" },
    "preview": { "$ref": "#/definitions/surface" },
    "lastCommandId": { "type": ["string", "null"] },
    "updatedAt": { "type": "integer", "minimum": 0 }
  },
  "definitions": {
    "surface": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "visible",
        "emergencyClear",
        "replaySuppressed",
        "mode",
        "delayMs",
        "autoHideOnDisconnect",
        "modules"
      ],
      "properties": {
        "visible": { "type": "boolean" },
        "emergencyClear": { "type": "boolean" },
        "replaySuppressed": { "type": "boolean" },
        "mode": { "enum": ["compact", "full"] },
        "delayMs": { "type": "integer", "minimum": 0, "maximum": 15000 },
        "autoHideOnDisconnect": { "type": "boolean" },
        "modules": {
          "type": "object",
          "additionalProperties": false,
          "required": ["score", "players", "observed", "series", "spike"],
          "properties": {
            "score": { "type": "boolean" },
            "players": { "type": "boolean" },
            "observed": { "type": "boolean" },
            "series": { "type": "boolean" },
            "spike": { "type": "boolean" }
          }
        }
      }
    }
  }
}
